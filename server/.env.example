# Copy this file to .env and fill in real values. Never commit .env.

# Local MongoDB (MongoDB Community Server) or a MongoDB Atlas connection string.
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=human_atlas_studio

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

PORT=5050
# Origin of the Vite dev server (used for the CORS allow-list in development).
CLIENT_ORIGIN=http://localhost:3016
NODE_ENV=development

# Optional: NCBI E-utilities identification. An API key raises the limit from 3 to 10 requests/second.
NCBI_API_KEY=
NCBI_EMAIL=
